# Copia este archivo como ".dev.vars" para probar en tu ordenador (npm run dev).
# Son secretos de PRUEBA. Los de verdad se guardan en Cloudflare con setup.ps1.
VERIFY_TOKEN=test-verify-token
APP_SECRET=topsecret
ADMIN_PASSWORD=admin-pass-1
STAFF_PASSWORD=staff-pass-1
SESSION_SECRET=0123456789abcdef0123456789abcdef
# WHATSAPP_TOKEN=   (sin token, el bot escribe las respuestas en la consola en vez de enviarlas)
